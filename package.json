{
  "name": "@windust/pi-goal",
  "version": "0.3.0",
  "description": "Robust context-neutral goals for Pi with TUI and pi-web controls",
  "type": "commonjs",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "goal",
    "automation"
  ],
  "files": [
    ".pi/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      ".pi/extensions/pi-goal"
    ],
    "skills": [
      "skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.6",
    "@earendil-works/pi-tui": ">=0.80.6"
  },
  "devDependencies": {
    "jiti": "^2.7.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "check": "pi --no-extensions -e ./.pi/extensions/pi-goal/index.ts --list-models __pi_goal_load_check__",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/**/*.test.cjs",
    "pack:dry": "npm pack --dry-run"
  },
  "author": "WindustH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WindustH/pi-goal.git"
  },
  "bugs": {
    "url": "https://github.com/WindustH/pi-goal/issues"
  },
  "homepage": "https://github.com/WindustH/pi-goal#readme",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
